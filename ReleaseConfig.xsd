<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="NewDataSet" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
  <xs:element name="ReleaseConfig">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Name" type="xs:string" minOccurs="0" />
        <xs:element name="Folder" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="xs:string" />
            <xs:attribute name="name-version" type="xs:string" />
            <xs:attribute name="path" type="xs:string" />
            <xs:attribute name="version" type="xs:string" />
          </xs:complexType>
        </xs:element>
        <xs:element name="Target" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Set" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" />
                  <xs:attribute name="value" type="xs:string" />
                  <xs:attribute name="transform" type="xs:string" use="optional" />
                  <xs:attribute name="secret" type="xs:boolean" use="optional" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" />
            <xs:attribute name="path" type="xs:string" />
            <xs:attribute name="archive-version" type="xs:string" />
            <xs:attribute name="type">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="zip"/>
                  <xs:enumeration value="folder"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
        <xs:element name="Artefacts" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:choice maxOccurs="unbounded">
                <xs:element minOccurs="0" name="folder">
                  <xs:complexType>
                    <xs:simpleContent>
                      <xs:extension base="xs:string">
                        <xs:attribute name="skip-directories-front" type="xs:int" use="optional" />
                      </xs:extension>
                    </xs:simpleContent>
                  </xs:complexType>
                </xs:element>
                <xs:element name="build" minOccurs="0" maxOccurs="unbounded">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:choice maxOccurs="unbounded">
                        <xs:element name="clean" minOccurs="0" maxOccurs="unbounded">
                          <xs:complexType>
                            <xs:attribute name="folder" type="xs:string" use="required" />
                            <xs:attribute name="include-folders" type="xs:boolean" use="optional" />
                            <xs:attribute name="match" type="xs:string" use="optional" />
                            <xs:attribute name="active" type="xs:string" use="optional" />
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="copy" minOccurs="0" maxOccurs="unbounded">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="transform-content" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                  <xs:attribute name="transform" type="xs:string" use="required" />
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                            <xs:attribute name="from" type="xs:string" use="required" />
                            <xs:attribute name="to" type="xs:string" use="optional" />
                            <xs:attribute name="match" type="xs:string" use="optional" />
                            <xs:attribute name="name" type="xs:string" use="optional" />
                            <xs:attribute name="recursive" type="xs:boolean" use="optional" />
                            <xs:attribute name="transform" type="xs:string" use="optional" />
                            <xs:attribute name="active" type="xs:string" use="optional" />
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="modify" minOccurs="0" maxOccurs="unbounded">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="transform-content" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                  <xs:attribute name="transform" type="xs:string" use="required" />
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                            <xs:attribute name="file" type="xs:string" use="required" />
                            <xs:attribute name="active" type="xs:string" use="optional" />
                          </xs:complexType>
                        </xs:element>
                        <xs:element minOccurs="0" maxOccurs="unbounded" name="xml-edit">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:choice minOccurs="0" maxOccurs="unbounded">
                                <xs:element name="node">
                                  <xs:complexType>
                                    <xs:attribute name="path" type="xs:string" use="optional" />
                                    <xs:attribute name="action" type="xs:string" use="optional" />
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="attribute">
                                  <xs:complexType>
                                    <xs:attribute name="path" type="xs:string" use="optional" />
                                    <xs:attribute name="action" type="xs:string" use="optional" />
                                  </xs:complexType>
                                </xs:element>
                              </xs:choice>
                            </xs:sequence>
                            <xs:attribute name="file" type="xs:string" use="optional" />
                            <xs:attribute name="omit-declaration" type="xs:boolean" use="optional" />
                            <xs:attribute name="active" type="xs:string" use="optional" />
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="exec" minOccurs="0" maxOccurs="unbounded">
                          <xs:complexType>
                            <xs:attribute name="app" type="xs:string" use="required" />
                            <xs:attribute name="args" type="xs:string" use="optional" />
                            <xs:attribute name="folder" type="xs:string" use="optional" />
                            <xs:attribute name="required-exit-codes" type="xs:string" use="optional" />
                            <xs:attribute name="active" type="xs:string" use="optional" />
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="check-certificate" minOccurs="0" maxOccurs="unbounded">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="trust-root" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                  <xs:attribute name="file" type="xs:string" use="required" />
                                  <xs:attribute name="password" type="xs:string" use="optional" />
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                            <xs:attribute name="file" type="xs:string" use="required" />
                            <xs:attribute name="password" type="xs:string" use="optional" />
                            <xs:attribute name="min-days" type="xs:int" use="optional" />
                            <xs:attribute name="private-key" type="xs:boolean" use="optional" />
                            <xs:attribute name="purpose" type="certificate-purpose" use="optional" />
                            <xs:attribute name="eku" type="xs:string" use="optional" />
                            <xs:attribute name="key-algorithm" type="certificate-key" use="optional" />
                            <xs:attribute name="min-key-size" type="xs:int" use="optional" />
                            <xs:attribute name="trusted" type="xs:boolean" use="optional" />
                            <xs:attribute name="revocation" type="xs:boolean" use="optional" />
                            <xs:attribute name="thumbprint" type="xs:string" use="optional" />
                            <xs:attribute name="subject" type="xs:string" use="optional" />
                            <xs:attribute name="prefix" type="xs:string" use="optional" />
                            <xs:attribute name="on-fail" use="optional">
                              <xs:simpleType>
                                <xs:restriction base="xs:string">
                                  <xs:enumeration value="stop"/>
                                  <xs:enumeration value="error"/>
                                  <xs:enumeration value="warn"/>
                                </xs:restriction>
                              </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="active" type="xs:string" use="optional" />
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="create-certificate" minOccurs="0" maxOccurs="unbounded">
                          <xs:complexType>
                            <xs:attribute name="file" type="xs:string" use="required" />
                            <xs:attribute name="subject" type="xs:string" use="required" />
                            <xs:attribute name="password" type="xs:string" use="optional" />
                            <xs:attribute name="days" type="xs:int" use="optional" />
                            <xs:attribute name="not-before" type="xs:string" use="optional" />
                            <xs:attribute name="purpose" type="certificate-purpose" use="optional" />
                            <xs:attribute name="eku" type="xs:string" use="optional" />
                            <xs:attribute name="key-usage" type="xs:string" use="optional" />
                            <xs:attribute name="key" type="certificate-key" use="optional" />
                            <xs:attribute name="key-size" type="xs:int" use="optional" />
                            <xs:attribute name="hash" use="optional">
                              <xs:simpleType>
                                <xs:restriction base="xs:string">
                                  <xs:enumeration value="sha256"/>
                                  <xs:enumeration value="sha384"/>
                                  <xs:enumeration value="sha512"/>
                                </xs:restriction>
                              </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="dns-names" type="xs:string" use="optional" />
                            <xs:attribute name="issuer-file" type="xs:string" use="optional" />
                            <xs:attribute name="issuer-password" type="xs:string" use="optional" />
                            <xs:attribute name="overwrite" type="xs:boolean" use="optional" />
                            <xs:attribute name="prefix" type="xs:string" use="optional" />
                            <xs:attribute name="on-fail" use="optional">
                              <xs:simpleType>
                                <xs:restriction base="xs:string">
                                  <xs:enumeration value="stop"/>
                                  <xs:enumeration value="error"/>
                                  <xs:enumeration value="warn"/>
                                </xs:restriction>
                              </xs:simpleType>
                            </xs:attribute>
                            <xs:attribute name="active" type="xs:string" use="optional" />
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="create" nillable="true" minOccurs="0" maxOccurs="unbounded">
                          <xs:complexType>
                            <xs:simpleContent>
                              <xs:extension base="xs:string">
                                <xs:attribute name="file" type="xs:string" use="required" />
                                <xs:attribute name="active" type="xs:string" use="optional" />
                              </xs:extension>
                            </xs:simpleContent>
                          </xs:complexType>
                        </xs:element>
                        <xs:element name="release-builder" minOccurs="0" maxOccurs="unbounded">
                          <xs:complexType>
                            <xs:sequence>
                              <xs:element name="Set" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                  <xs:attribute name="name" type="xs:string" />
                                  <xs:attribute name="value" type="xs:string" />
                                  <xs:attribute name="transform" type="xs:string" use="optional" />
                                  <xs:attribute name="secret" type="xs:boolean" use="optional" />
                                </xs:complexType>
                              </xs:element>
                            </xs:sequence>
                            <xs:attribute name="name" type="xs:string" use="optional" />
                            <xs:attribute name="folder" type="xs:string" use="optional" />
                            <xs:attribute name="process" type="xs:boolean" use="optional" />
                            <xs:attribute name="file" type="xs:string" use="optional" />
                            <xs:attribute name="nobuild" type="xs:boolean" use="optional" />
                            <xs:attribute name="active" type="xs:string" use="optional" />
                          </xs:complexType>
                        </xs:element>
                      </xs:choice>
                    </xs:sequence>
                    <xs:attribute name="folder" type="xs:string" use="optional" />
                  </xs:complexType>
                </xs:element>
                <xs:element name="file" nillable="true" minOccurs="0" maxOccurs="unbounded">
                  <xs:complexType>
                    <xs:simpleContent>
                      <xs:extension base="xs:string">
                        <xs:attribute name="folder" type="xs:string" use="optional" />
                        <xs:attribute name="newname" type="xs:string" use="optional" />
                        <xs:attribute name="skip-directories-front" type="xs:int" use="optional" />
                        <xs:attribute name="name" type="xs:string" use="optional" />
                      </xs:extension>
                    </xs:simpleContent>
                  </xs:complexType>
                </xs:element>
              </xs:choice>
            </xs:sequence>
            <xs:attribute name="folder" type="xs:string" use="optional" />
            <xs:attribute name="active" type="xs:string" use="optional" />
          </xs:complexType>
        </xs:element>
        <xs:element name="Artefact" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="folder" type="xs:string" use="optional" />
            <xs:attribute name="directory" type="xs:string" use="optional" />
            <xs:attribute name="file" type="xs:string" use="optional" />
            <xs:attribute name="root" type="xs:string" use="optional" />
            <xs:attribute name="newname" type="xs:string" use="optional" />
            <xs:attribute name="skip-directories-front" type="xs:int" use="optional" />
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="unbounded" name="ReleaseBuilder">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Set" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" />
                  <xs:attribute name="value" type="xs:string" />
                  <xs:attribute name="transform" type="xs:string" use="optional" />
                  <xs:attribute name="secret" type="xs:boolean" use="optional" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="optional" />
            <xs:attribute name="folder" type="xs:string" use="optional" />
            <xs:attribute name="process" type="xs:boolean" use="optional" />
            <xs:attribute name="file" type="xs:string" use="optional" />
            <xs:attribute name="nobuild" type="xs:boolean" use="optional" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="certificate-purpose">
    <xs:restriction base="xs:string">
      <xs:enumeration value="token-signing"/>
      <xs:enumeration value="code-signing"/>
      <xs:enumeration value="server-auth"/>
      <xs:enumeration value="client-auth"/>
      <xs:enumeration value="ca"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="certificate-key">
    <xs:restriction base="xs:string">
      <xs:enumeration value="rsa"/>
      <xs:enumeration value="ecdsa"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
